# Copy this file to .env for local development.
# Never commit real credentials. Keep SUPABASE_SERVICE_ROLE_KEY server-side only.

NODE_ENV=development
PORT=4000
TRUST_PROXY=0

# Required Supabase project settings
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Required in production; comma-separated exact frontend origins
ALLOWED_ORIGINS=http://127.0.0.1:3002,https://YOUR_FRONTEND_HOST

# Consent/policy version shown by the API
CONSENT_POLICY_VERSION=2026-11-05

# Optional payment settings. Payments are disabled unless valid keys exist.
PAYMENT_REQUIRED=false
PAYMENT_AMOUNT_PAISE=5000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional realtime voice/call infrastructure. Live calls are not part of current launch.
ICE_SERVERS_JSON=

# Optional external AI screening; disabled by default.
AI_EXTERNAL_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
